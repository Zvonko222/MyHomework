<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ui.home.declaration.DeclarationFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/bold_title_button_font"
            android:text="Customs Declaration"
            android:textColor="#D204346A"
            android:textSize="25dp" />

        <ImageView
            android:id="@+id/img_declaration_add_declaration"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_add_48" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_margin="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_declaration_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_gray"
                android:fontFamily="@font/bold_title_button_font"
                android:gravity="center"
                android:text="Pending"
                android:textAllCaps="false" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_declaration_rejected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_gray"
                android:fontFamily="@font/bold_title_button_font"
                android:gravity="center"
                android:text="Rejected"
                android:textAllCaps="false" />

            <androidx.appcompat.widget.AppCompatButton

                android:id="@+id/btn_declaration_approved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_gray"
                android:fontFamily="@font/bold_title_button_font"
                android:gravity="center"
                android:text="Approved"
                android:textAllCaps="false" />
        </LinearLayout>
        <EditText
            android:id="@+id/et_declaration_search_voyage_number_or_container_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text_gray"
            android:hint="Voyage Number/Container Number"
            android:textSize="15dp"
            android:drawableStart="@drawable/outline_badminton_24"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_declaration_customs_declarations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"/>


    </LinearLayout>

</LinearLayout>
