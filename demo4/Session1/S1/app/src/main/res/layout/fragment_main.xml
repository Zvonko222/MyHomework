<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="#E0000070"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold_title_button_font"
            android:gravity="center_horizontal"
            android:text="Voyage Searching"
            android:textColor="@color/white"
            android:textSize="20dp" />



        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_main_search_voyage_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edit_text_white"
                android:drawableStart="@drawable/outline_badminton_24"
                android:fontFamily="@font/light_main_text_font"
                android:hint="Voyage number"
                android:textColor="@color/black"
                android:textColorHint="#D916993A" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:fontFamily="@font/regular_font"
                    android:text="Departure From:"
                    android:textColor="@color/white" />


                <TextView
                    android:id="@+id/tv_main_departure_from"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="0.7"
                    android:background="@drawable/bg_edit_text_white"
                    android:fontFamily="@font/light_main_text_font" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="0.4"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/regular_font"
                    android:text="Departure Date:"
                    android:textColor="@color/white" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="0.7">

                    <TextView
                        android:id="@+id/tv_main_departure_date"
                        android:layout_width="match_parent"
                        android:focusable="false"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_edit_text_white"
                        android:fontFamily="@font/light_main_text_font" />
                    <CheckBox
                        android:id="@+id/cb_main_departure_date"
                        android:layout_gravity="right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="0.4"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/regular_font"
                    android:text="Arrival Date:"
                    android:textColor="@color/white" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="0.7">

                    <TextView
                        android:id="@+id/tv_main_arrival_date"
                        android:layout_width="match_parent"
                        android:focusable="false"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_edit_text_white"
                        android:fontFamily="@font/light_main_text_font" />
                    <CheckBox
                        android:id="@+id/cb_main_arrival_date"
                        android:layout_gravity="right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="0.4"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/regular_font"
                    android:text="Voyage Status:"
                    android:textColor="@color/white" />

                <Spinner
                    android:id="@+id/sp_main_voyage_status"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    android:layout_height="35dp"
                    android:background="@drawable/bg_edit_text_white"
                    android:spinnerMode="dropdown" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_margin="10dp">
        <TextView
            android:id="@+id/tv_main_number_of_voyages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 voyages found"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/rv_main_voyage" />
    </LinearLayout>

</LinearLayout>
